{
  "name": "@appenglish/auth-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --check src/main.js",
    "dev": "node --env-file=../../.env --watch src/main.js",
    "start": "node --env-file=../../.env src/main.js",
    "lint": "node --check src/main.js",
