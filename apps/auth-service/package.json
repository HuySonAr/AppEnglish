    "admin:bootstrap": "node --env-file=../../.env src/database/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "pg": "^8.16.3",
    "@grpc/grpc-js": "^1.14.0",
    "amqplib": "^0.10.9",
    "ioredis": "^5.8.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^3.25.76",
    "nodemailer": "^7.0.6",
    "@appenglish/auth-contracts": "workspace:*"
  }
}
