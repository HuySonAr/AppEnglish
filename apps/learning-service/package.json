{
  "name": "@appenglish/learning-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --check src/main.js",
    "dev": "node --env-file=../../.env --watch src/main.js",
    "start": "node --env-file=../../.env src/main.js",
    "lint": "node ../../scripts/check-syntax.mjs src test",
    "test": "node --test test/*.test.js",
    "migration:run": "node --env-file=../../.env src/database/run-migrations.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "pg": "^8.16.3",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@appenglish/auth-contracts": "workspace:*",
    "@appenglish/content-contracts": "workspace:*",
    "@appenglish/learning-contracts": "workspace:*",
    "amqplib": "^0.10.9",
    "ioredis": "^5.8.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^3.25.76"
  }
}
