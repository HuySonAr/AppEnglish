NODE_ENV=development
LOG_LEVEL=info

GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=50051
CONTENT_SERVICE_PORT=3002
CONTENT_GRPC_HOST=localhost
CONTENT_GRPC_PORT=50052
LEARNING_SERVICE_PORT=3003
LEARNING_GRPC_HOST=localhost
LEARNING_GRPC_PORT=50053
PROGRESS_SERVICE_PORT=3004
WRITING_SERVICE_PORT=3005
PROGRESS_GRPC_HOST=localhost
PROGRESS_GRPC_PORT=50054
WEB_CLIENT_PORT=5173
# Address of the web client, used in invitation emails (D131).
WEB_APP_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
AUTH_DATABASE_NAME=app_identity
CONTENT_DATABASE_NAME=app_content
LEARNING_DATABASE_NAME=app_learning
PROGRESS_DATABASE_NAME=app_progress

REDIS_URL=redis://localhost:6379
# Gateway rate limits (D117). RATE_LIMIT_STORE: redis (default when REDIS_URL is
# set) or memory; RATE_LIMIT_ENABLED=false turns them off; TRUST_PROXY=true
# reads the client address from X-Forwarded-For behind a reverse proxy.
RATE_LIMIT_STORE=redis
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
RABBITMQ_URL=amqp://localhost:5672
GATEWAY_URL=http://localhost:3000

# Auth session (backend only; never expose these as VITE_* variables)
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
AUTH_OTP_SECRET=replace-with-another-random-backend-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Avatars (F09, D113; backend only). AVATAR_STORAGE_ADAPTER: local or imagekit.
# local keeps files under AVATAR_LOCAL_ROOT and auth-service serves them at
# AVATAR_LOCAL_PUBLIC_URL; imagekit uses the IMAGEKIT_* keys below (D68).
AVATAR_STORAGE_ADAPTER=local
AVATAR_LOCAL_ROOT=storage/avatars
AVATAR_LOCAL_PUBLIC_URL=http://localhost:3001/avatars
AVATAR_MAX_FILE_SIZE_BYTES=2097152

# Content media storage (backend only; never expose storage keys to Vite).
# MEDIA_STORAGE_ADAPTER: local, imagekit or r2
MEDIA_STORAGE_ADAPTER=local
MEDIA_LOCAL_ROOT=storage/media
MEDIA_LOCAL_PUBLIC_URL=http://localhost:3002/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Cloudflare R2 (S3-compatible). R2_PUBLIC_BASE_URL is the bucket's public
# address, e.g. https://pub-xxxx.r2.dev or a custom domain, without a path.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Pronunciation of vocabulary (D123): IPA and British/American MP3 made by
# speech-service with Piper (default, no outside service). "dictionary" uses
# the free dictionary of D47 instead. The IPA shown is the UK one (D148), or
# the US one with "us".
PRONUNCIATION_SOURCE=speech
PRONUNCIATION_IPA_ACCENT=uk
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
# speech-service voices (Piper, downloaded on first use into apps/speech-service/.cache/voices)
PIPER_VOICE_UK=en_GB-cori-medium
PIPER_VOICE_US=en_US-lessac-medium
# PIPER_VOICES_DIR=apps/speech-service/.cache/voices
PRONOUNCE_WORKERS=2
# SPEECH_AUDIO_CACHE_DIR=apps/speech-service/.cache/audio

# Writing grading (D172, D175): learners bring their own Gemini key; this secret encrypts the stored keys
GEMINI_KEY_SECRET=replace-with-at-least-32-random-characters
GEMINI_MODEL=gemini-3.8-flash
WRITING_CONCURRENCY=2
