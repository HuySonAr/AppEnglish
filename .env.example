NODE_ENV=development
LOG_LEVEL=info

GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CONTENT_SERVICE_PORT=3002
LEARNING_SERVICE_PORT=3003
PROGRESS_SERVICE_PORT=3004
WEB_CLIENT_PORT=5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
AUTH_DATABASE_NAME=app_identity
CONTENT_DATABASE_NAME=app_content
LEARNING_DATABASE_NAME=app_learning
PROGRESS_DATABASE_NAME=app_progress

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
GATEWAY_URL=http://localhost:3000

# Auth session (backend only; never expose these as VITE_* variables)
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
AUTH_OTP_SECRET=replace-with-another-random-backend-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Content media storage (backend only; never expose ImageKit private key to Vite)
MEDIA_STORAGE_ADAPTER=local
MEDIA_LOCAL_ROOT=storage/media
MEDIA_LOCAL_PUBLIC_URL=http://localhost:3002/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
